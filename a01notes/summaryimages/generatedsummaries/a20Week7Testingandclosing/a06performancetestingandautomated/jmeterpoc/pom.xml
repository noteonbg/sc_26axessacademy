<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ================================================================= -->
    <!-- SPRING BOOT STARTER PARENT                                        -->
    <!-- WHY IT EXISTS: Provides curated dependency versions, default Java -->
    <!-- compiler settings, and plugin configurations for Spring Boot.     -->
    <!-- ================================================================= -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.3</version>
        <relativePath/>
    </parent>

    <groupId>com.sc</groupId>
    <artifactId>jmeterpoc</artifactId>
    <version>1.0.0</version>
    <name>SC Employees Performance Testing POC</name>
    <description>Spring Boot REST API for Apache JMeter 50-User Load Testing</description>

    <!-- Java Version: Standard Chartered Modern Enterprise Java 21 LTS -->
    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <!-- ============================================================= -->
        <!-- 1. SPRING BOOT STARTER WEB                                    -->
        <!-- WHY IT EXISTS: Brings in:                                     -->
        <!--    - Embedded Apache Tomcat HTTP Server                       -->
        <!--    - Spring MVC Framework (@RestController, @GetMapping)      -->
        <!--    - Jackson JSON library for automatic payload serialization  -->
        <!-- ============================================================= -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- ============================================================= -->
        <!-- 2. SPRING BOOT STARTER ACTUATOR                               -->
        <!-- WHY IT EXISTS: Exposes production-ready monitoring endpoints  -->
        <!-- like /actuator/health and /actuator/metrics for checking      -->
        <!-- server responsiveness and thread health under load.           -->
        <!-- ============================================================= -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ============================================================= -->
        <!-- 3. SPRING BOOT STARTER TEST                                   -->
        <!-- WHY IT EXISTS: Includes JUnit 5, AssertJ, and Mockito for     -->
        <!-- unit and integration testing.                                 -->
        <!-- ============================================================= -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- Build plugins: Package executable fat-JAR -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
